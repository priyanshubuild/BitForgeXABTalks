# ── Google Gemini API Key (FREE tier — primary LLM) ──────────────────────────
# Get yours FREE at: https://aistudio.google.com/app/apikey
# Model: gemini-2.0-flash (free, fast, high-quality)
GEMINI_API_KEY=your_gemini_api_key_here

# ── Breeth Memory Layer (provided by Vicodathon organizers) ───────────────────
BREETH_API_KEY=your_breeth_api_key_here

# ── Local API settings ───────────────────────────────────────────────────────
# Comma-separated origins allowed to call the backend. Do not use * in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
# Enables the development-only GET /api/sessions endpoint.
DEBUG_API=false
